rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidSemester(data) {
      return data.id is string &&
        data.id.size() <= 128 &&
        data.name is string &&
        data.name.size() > 0 &&
        data.name.size() <= 200;
    }

    function isValidCatalog(data) {
      return data.id is string &&
        data.id.size() <= 128;
    }

    // Public read & write with data validation so anyone on any machine can see & sync
    match /semesters/{semesterId} {
      allow read: if true;
      allow write: if isValidId(semesterId) && isValidSemester(incoming());
    }

    match /catalogs/{catalogId} {
      allow read: if true;
      allow write: if isValidId(catalogId) && isValidCatalog(incoming());
    }
  }
}

